{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Survey": {
    "ConfigurationFile": "Configuration/survey.json",
    "ReloadOnChange": true
  },
  "FeatureFlags": {
    "EnableFormValidation": false,
    "EnableSqlPersistence": false
  },
  "Authentication": {
    "Mode": "none",
    "Keycloak": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "RequireHttpsMetadata": true,
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-callback-oidc"
    }
  },
  "ConnectionStrings": {
    "SurveyDatabase": ""
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "PathBase": ""
  }
}
