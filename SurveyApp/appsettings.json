{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Survey": {
    "ConfigurationFile": "Configuration/survey.json",
    "ReloadOnChange": true
  },
  "FeatureFlags": {
    "EnableFormValidation": false,
    "EnableSqlPersistence": false
  },
  "Authentication": {
    "Mode": "keycloak",
    "Keycloak": {
      "Authority": "http://localhost:8080/realms/razor-primary",
      "ClientId": "razor-app",
      "ClientSecret": "razor-primary-local-secret",
      "RequireHttpsMetadata": false,
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-callback-oidc"
    }
  },
  "ConnectionStrings": {
    "SurveyDatabase": ""
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "PathBase": ""
  }
}
