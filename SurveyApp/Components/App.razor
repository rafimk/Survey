@inject SurveyApp.Services.ISurveyConfigurationService Configuration

<!DOCTYPE html>
<html lang="@Configuration.Current.Language" dir="@Configuration.Current.Direction">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* PathBase-aware so the app also works in an IIS virtual directory or behind a path-prefixing proxy. *@
    <base href="@(HttpContext.Request.PathBase + "/")" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SurveyApp.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Pages marked [ExcludeFromInteractiveRouting] (error, sign-in failure, signed-out) render statically, so they work
    // without a circuit — which could not be established for a user who is not authenticated.
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
